# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-public-key

# SECRET : serveur uniquement (Server Actions). Ne JAMAIS préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key

# Utilisés uniquement par `npm run seed:super-admin`
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMoi!2026
SEED_SUPER_ADMIN_NAME=Super Admin

# --- FedaPay (agrégateur de paiement) ---
# Compte gratuit : https://sandbox.fedapay.com  >  Paramètres  >  Clés API  (clé secrète "sk_sandbox_...")
# Ces valeurs sont SECRÈTES (serveur uniquement) : ne jamais les préfixer par NEXT_PUBLIC_.
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxx
# Secret de l'endpoint webhook (FedaPay > Webhooks > votre endpoint > "Click to reveal") : wh_sandbox_...
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxxxxxxxxxx
# Adresse publique du site (utilisée pour le retour après paiement). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
